{
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "formatWithErrors": false,
    "lineWidth": 100,
    "expand": null
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "lineWidth": 100,
      "lineEnding": "lf"
    }
  },
  "linter": {
    "enabled": true,
    "includes": [
      "src/**/*.ts",
      "test/**/*.ts",
      "!**/*.min.js"
    ],
    "rules": {
      "eqeqeq": "error",
      "curly": "error",
      "no-console": "warn",
      "no-debugger": "error",
      "no-unused-vars": [
        "warn",
        {
          "varsIgnorePattern": "^_",
          "args": "none"
        }
      ],
      "@typescript-eslint/no-unused-vars": [
        "warn",
        {
          "varsIgnorePattern": "^_",
          "args": "none"
        }
      ],
      "sort-imports": [
        "error",
        {
          "ignoreCase": true,
          "ignoreDeclarationSort": false,
          "ignoreMemberSort": false,
          "memberSyntaxSortOrder": [
            "none",
            "all",
            "multiple",
            "single"
          ]
        }
      ]
    }
  },
  "assist": {
    "enabled": true
  },
  "files": {
    "includes": [
      "src/**/*.ts",
      "test/**/*.ts",
      "!**/*.min.js"
    ]
  },
  "importResolver": {
    "node": {
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".json"
      ],
      "moduleDirectory": [
        "node_modules",
        "src"
      ]
    }
  }
}
